# Google Gemini API key — used by the summarizer (free tier at aistudio.google.com).
GEMINI_API_KEY=

# Base URL of the case API (the case-api/ service), no trailing slash.
# e.g. https://my-case-api.onrender.com
CASE_API_BASE_URL=

# Shared secret. Set the SAME value here and in the case-api service's env.
# Used as a Bearer token between the summary tool and the case API.
CASE_API_TOKEN=
