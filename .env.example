# Google Gemini API key — used by the summarizer (free tier at aistudio.google.com).
GEMINI_API_KEY=

# Base URL of the case API (the case-api/ service), no trailing slash.
# e.g. https://my-case-api.onrender.com
CASE_API_BASE_URL=

# Shared secret. Set the SAME value here and in the case-api service's env.
# Used as a Bearer token between the summary tool and the case API.
CASE_API_TOKEN=

# --- Agent Console (console/) ---------------------------------------------
# Seed admin credentials, created once on first startup (empty DB).
# CHANGE THESE before any real deployment.
CONSOLE_ADMIN_EMAIL=admin@example.com
CONSOLE_ADMIN_PASSWORD=admin123

# Optional: path to the SQLite database file (defaults to console/console.db).
# CONSOLE_DB_PATH=/data/console.db
